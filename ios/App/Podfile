require_relative '../../../facility-app/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../../facility-app/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../../facility-app/node_modules/@capacitor/ios'
  pod 'CapacitorApp', :path => '../../../facility-app/node_modules/@capacitor/app'
  pod 'CapacitorHaptics', :path => '../../../facility-app/node_modules/@capacitor/haptics'
  pod 'CapacitorKeyboard', :path => '../../../facility-app/node_modules/@capacitor/keyboard'
  pod 'CapacitorStatusBar', :path => '../../../facility-app/node_modules/@capacitor/status-bar'
  pod 'EbarooniCapacitorCalendar', :path => '../../../facility-app/node_modules/@ebarooni/capacitor-calendar'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # Current Xcode builds nothing older than iOS 15; some plugins still declare 14.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0' if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
    end
  end
end
